    "    \"modelo__max_depth\": [4, 6, 8, 10, 15, None],\n",
    "    \"modelo__min_samples_leaf\": [1, 5, 10, 20, 50],\n",
    "    \"modelo__max_features\": [\"sqrt\", 0.3, 0.5],\n",
    "}"
   ]
